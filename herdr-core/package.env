# GitHub repo the bump workflow tracks
UPSTREAM=herdrdev/herdr-core
TAG_PREFIX=v
# herdr-core publishes tags but no GitHub releases: track the newest vX.Y.Z tag
TRACK=tags
# Built in the herdr COPR project, next to herdr and herdr-app
COPR_PROJECT=herdr
# Cargo fetches crates, %prep fetches the Ghostty submodule, Zig its dependencies
ENABLE_NET=on
