# Copy to <pkg>/package.env (this copy is .example so the bump workflow skips it).
# GitHub owner/repo whose latest stable release the bump workflow tracks.
# Leave empty to disable automatic version bumps for this package.
UPSTREAM=owner/repo
# Part of the release tag before the version (v1.2.3 -> "v", 1.2.3 -> "").
TAG_PREFIX=v
# "on" if the build downloads anything (Go modules, Rust crates, npm, ...).
ENABLE_NET=on
# Optional: track upstream's newest version tag instead of GitHub releases
# (for upstreams that tag without publishing releases).
#TRACK=tags
# Optional: build in another package's COPR project (oytal/<that pkg>).
#COPR_PROJECT=other-pkg
