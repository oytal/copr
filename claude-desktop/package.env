# Anthropic publishes claude-desktop only as an apt repository
# (https://downloads.claude.ai/claude-desktop/apt/stable), with no GitHub
# release or tag to follow, so the bump workflow can't track it: bump
# Version: by hand from the Packages index of that repository.
UPSTREAM=
# The official .deb is repackaged: nothing is downloaded at build time
ENABLE_NET=off
