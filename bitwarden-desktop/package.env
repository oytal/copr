# GitHub repo the bump workflow tracks (also used for the project's package link)
UPSTREAM=bitwarden/clients
# The monorepo holds web, browser, cli and desktop; desktop tags are desktop-v<version>
TAG_PREFIX=desktop-v
# The newest GitHub release is not always a desktop one: track the desktop tags
TRACK=tags
# npm ci, Cargo crates and the Electron binary are downloaded at build time
ENABLE_NET=on
