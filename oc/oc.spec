# Upstream tags look like openshift-clients-<version>-<build timestamp>. RPM
# Version can't hold the "-", so the timestamp lives here, next to the tag.
%global debug_package %{nil}
%global goipath github.com/openshift/oc
%global tagts 202610271435
%global gittag openshift-clients-%{version}-%{tagts}

Name:           oc
Version:        5.0.0
Release:        1%{?dist}
Summary:        OpenShift command-line client

License:        Apache-2.0
URL:            https://%{goipath}
# The tag prefix is TAG_PREFIX in package.env; change both together
Source0:        %{url}/archive/refs/tags/openshift-clients-%{version}-%{tagts}.tar.gz

ExclusiveArch:  x86_64 aarch64

BuildRequires:  golang >= 1.26
BuildRequires:  make
BuildRequires:  gcc
BuildRequires:  git-core
BuildRequires:  pkgconfig(krb5-gssapi)

Recommends:     krb5-libs

%description
oc is the command-line client for OpenShift, the Kubernetes distribution
from Red Hat. It talks to OpenShift and Kubernetes clusters and covers the
kubectl command set plus OpenShift-specific commands such as login,
projects and new-app.

%prep
%autosetup -n oc-%{gittag}

%build
# The vendor/ directory is in the tarball, so the build needs no network.
# Version information comes from the tag, as the upstream release build does.
make build GO_BUILD_PACKAGES='./cmd/oc ./tools/genman' \
    SOURCE_GIT_TAG=%{gittag} \
    SOURCE_GIT_TREE_STATE=clean

%install
install -Dpm 0755 oc %{buildroot}%{_bindir}/oc

# Man pages, generated by the tool upstream ships for it
install -d -m 0755 %{buildroot}%{_mandir}/man1
./genman %{buildroot}%{_mandir}/man1 oc

# Shell completions, in the locations each shell's package looks in
install -d %{buildroot}%{_datadir}/bash-completion/completions
%{buildroot}%{_bindir}/oc completion bash > %{buildroot}%{_datadir}/bash-completion/completions/oc
install -d %{buildroot}%{_datadir}/zsh/site-functions
%{buildroot}%{_bindir}/oc completion zsh > %{buildroot}%{_datadir}/zsh/site-functions/_oc
install -d %{buildroot}%{_datadir}/fish/vendor_completions.d
%{buildroot}%{_bindir}/oc completion fish > %{buildroot}%{_datadir}/fish/vendor_completions.d/oc.fish

%check
# The client has no desktop file. Smoke test: needs no cluster and no TTY.
%{buildroot}%{_bindir}/oc version --client

%files
%license LICENSE
%doc README.md
%{_bindir}/oc
%{_mandir}/man1/oc*.1*
%{_datadir}/bash-completion/completions/oc
%{_datadir}/zsh/site-functions/_oc
%{_datadir}/fish/vendor_completions.d/oc.fish

