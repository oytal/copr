# GitHub repo the bump workflow tracks (also used for the project's package link)
UPSTREAM=openshift/oc
TAG_PREFIX=openshift-clients-
# oc publishes tags but no GitHub releases: track the newest tag
TRACK=tags
# Tags are openshift-clients-<x.y.z>-<timestamp>. The timestamp lives in the
# %global tagts of oc.spec; the bump workflow rewrites it with each new version.
TAG_TS_MACRO=tagts
# Go builds from the vendor/ directory in the tarball, so no downloads are needed
ENABLE_NET=off
